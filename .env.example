# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for `supabase` CLI commands (start/db/migration) to even load
# config.toml, since [auth.external.apple] is enabled — see config.toml.
# Any placeholder value works for local dev; Apple Sign-In just won't work.
SUPABASE_AUTH_APPLE_CLIENT_ID=placeholder
SUPABASE_AUTH_APPLE_SECRET=placeholder

# ─── Neo4j ───────────────────────────────────────────────────
# Production: AuraDB
NEO4J_URI=https://your-instance-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-auradb-password
#
# Local testing via `docker compose up -d` (see docker-compose.yml), use
# instead:
#   NEO4J_URI=http://localhost:7474
#   NEO4J_USER=neo4j
#   NEO4J_PASSWORD=pawbook-dev-password

# ─── APNs (push notifications for lost pet / community alerts) ───
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_ID=your-auth-key-id
APNS_BUNDLE_ID=com.yourcompany.pawbook
APNS_ENV=sandbox
# Contents of the .p8 Auth Key from Apple Developer, newlines preserved:
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── DB trigger sync settings (used by migration 00019) ───
# These are Postgres database settings, not Edge Function secrets — set
# them via SQL, not `supabase secrets set`:
#   ALTER DATABASE postgres SET app.edge_function_url = 'https://your-project-ref.supabase.co/functions/v1';
#   ALTER DATABASE postgres SET app.service_role_key = 'your-service-role-key';
# Used by the profiles/pets/places/pet_relationships triggers to call the
# sync-owner-create, sync-owner-update, sync-pet-update, sync-place-update
# and sync-relationship-delete Edge Functions.
