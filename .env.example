# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Neo4j AuraDB ──────────────────────────────────────────
NEO4J_URI=https://your-instance-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-auradb-password

# ─── Optional: Neo4j Sync URL (used by DB trigger) ────────
# Set this in Supabase project settings → Database → app.neo4j_sync_url
# Points to the Edge Function that handles relationship sync
NEO4J_SYNC_EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/sync-relationship
